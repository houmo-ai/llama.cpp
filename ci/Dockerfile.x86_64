FROM ubuntu:20.04

# 配置时区
ENV TZ=Asia/Shanghai \
    DEBIAN_FRONTEND=noninteractive
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# 更新 apt 并安装 prerequisites（使用阿里云源）
RUN sed -i 's/archive.ubuntu.com/mirrors.aliyun.com/g' /etc/apt/sources.list && \
    sed -i 's/security.ubuntu.com/mirrors.aliyun.com/g' /etc/apt/sources.list && \
    DEBIAN_FRONTEND=noninteractive apt update && apt-get install -y \
    software-properties-common

# 添加 deadsnakes PPA 和 ubuntu-toolchain-r PPA（PPA 无法直接替换源，但可以加速 apt 更新）
RUN add-apt-repository -y ppa:deadsnakes/ppa && \
    add-apt-repository -y ppa:ubuntu-toolchain-r/test && \
    apt update

# 安装编译工具和 Python（使用阿里云源）
RUN apt install -y g++-13 git wget curl build-essential cmake python3-pip

# 安装交叉编译工具链

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    crossbuild-essential-arm64 \
    gcc-aarch64-linux-gnu \
    g++-aarch64-linux-gnu \
    libc6-dev-arm64-cross \
    pkg-config \
    libssl-dev \
    libcurl4-openssl-dev \
    zlib1g-dev && \
    rm -rf /var/lib/apt/lists/*

# 配置 pip 国内源（清华源）
# RUN pip config set global.index-url https://pypi.tuna.tsinghua.edu.cn/simple && \
#     pip config set global.timeout 5000

# 安装 PyTorch 和 GGUF（使用 pip 国内源）
# RUN pip install torch==2.4.1 --index-url https://download.pytorch.org/whl/cpu && \
#     pip install gguf

COPY libtorch /opt/libtorch
WORKDIR /houmo

# RUN pip cache purge